@inherits LayoutComponentBase

<a class="hms-skip-link" href="#main-content">Skip to main content</a>
<input id="hms-sidebar-toggle" class="hms-visually-hidden" type="checkbox" tabindex="-1" aria-hidden="true" aria-controls="primary-navigation" />
<div class="hms-shell">
    <aside class="hms-sidebar" aria-label="Application navigation">
        <NavMenu />
    </aside>
    <label class="hms-sidebar-scrim" for="hms-sidebar-toggle" aria-hidden="true"></label>

    <div class="hms-shell__content">
        <header class="hms-topbar">
            <div class="hms-topbar__inner">
                <button type="button" class="hms-menu-toggle" data-hms-menu-toggle aria-expanded="false" aria-controls="primary-navigation">
                    <span class="hms-menu-toggle__mark" aria-hidden="true">☰</span>
                    <span>Menu</span>
                </button>
                <div class="hms-topbar__context">
                    <span class="hms-topbar__product">EL-Shiekh Medical Complex</span>
                    <span class="hms-topbar__section">Hospital Management System</span>
                </div>
                <div class="hms-user-area">
                    <UserAccountMenu />
                </div>
                <button type="button" class="hms-theme-toggle" data-hms-theme-toggle onclick="window.hmsTheme.toggle()" title="Switch theme">
                    <span class="hms-theme-toggle__mark" aria-hidden="true">◐</span>
                    <span class="hms-theme-toggle__label">Theme</span>
                </button>
            </div>
        </header>

        <main id="main-content" class="hms-main" tabindex="-1">
            <article class="hms-content">
                @Body
            </article>
        </main>

        <footer class="hms-footer">
            <span>EL-Shiekh Medical Complex</span>
            <span>Operational workspace</span>
        </footer>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    <span>An unexpected error interrupted this screen.</span>
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss error">×</button>
</div>
