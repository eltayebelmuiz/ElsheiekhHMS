@page "/patients"
@rendermode InteractiveServer
@attribute [Authorize(Policy = PolicyNames.CanManagePatients)]

@inject IPatientService PatientService
<PageTitle>Patients</PageTitle>

<PageHeader Eyebrow="Patient operations" Title="Patients" Description="Find a patient record, review identity details, or begin a new registration.">
    <Actions>
        <a class="btn btn-primary" href="/patients/new">Register patient</a>
    </Actions>
</PageHeader>

<section class="hms-panel" aria-labelledby="patient-search-heading">
    <div class="hms-panel__header">
        <div>
            <p class="hms-eyebrow">Patient registry</p>
            <h2 id="patient-search-heading">Search records</h2>
        </div>
        @if (_page is not null)
        {
            <span class="hms-result-count">@_page.TotalCount result@( _page.TotalCount == 1 ? "" : "s")</span>
        }
    </div>
    <form class="hms-form" @onsubmit="SearchAsync" @onsubmit:preventDefault>
        <div class="hms-form__grid hms-form__grid--search">
            <div class="hms-field">
                <label for="patient-search-text">Name or patient code</label>
                <input id="patient-search-text" class="form-control" type="search" @bind="_searchText" maxlength="100" />
            </div>
            <div class="hms-field">
                <label for="patient-search-code">Patient code</label>
                <input id="patient-search-code" class="form-control" @bind="_patientCode" maxlength="13" />
            </div>
            <div class="hms-field">
                <label for="patient-search-phone">Phone</label>
                <input id="patient-search-phone" class="form-control" @bind="_phone" maxlength="32" />
            </div>
            <div class="hms-field">
                <label for="patient-search-national-id">National ID</label>
                <input id="patient-search-national-id" class="form-control" @bind="_nationalId" maxlength="100" />
            </div>
            <div class="hms-field">
                <label for="patient-search-passport">Passport number</label>
                <input id="patient-search-passport" class="form-control" @bind="_passportNumber" maxlength="100" />
            </div>
            <div class="hms-field">
                <label for="patient-search-date-of-birth">Date of birth</label>
                <input id="patient-search-date-of-birth" class="form-control" type="date" @bind="_dateOfBirth" />
            </div>
        </div>
        <div class="hms-form__grid hms-form__grid--search-options">
            <div class="hms-field">
                <label for="patient-sort">Sort by</label>
                <select id="patient-sort" class="form-select" @bind="_sortBy">
                    @foreach (var field in Enum.GetValues<PatientSortField>())
                    {
                        <option value="@field">@SortLabel(field)</option>
                    }
                </select>
            </div>
            <div class="hms-field">
                <label for="patient-sort-direction">Direction</label>
                <select id="patient-sort-direction" class="form-select" @bind="_sortDirection">
                    <option value="@SortDirection.Ascending">Ascending</option>
                    <option value="@SortDirection.Descending">Descending</option>
                </select>
            </div>
            <div class="hms-form__actions hms-form__actions--inline">
                <button type="submit" class="btn btn-primary" disabled="@_loading">Search</button>
                <button type="button" class="btn btn-outline-secondary" @onclick="ClearAsync" disabled="@_loading">Clear</button>
            </div>
        </div>
    </form>
</section>

@if (_loading)
{
    <LoadingState Message="Loading patient records" />
}
else if (_error)
{
    <ErrorState Title="Patient records unavailable" Message="The registry could not be loaded. Try again." >
        <Actions><button type="button" class="btn btn-outline-secondary" @onclick="SearchAsync">Retry</button></Actions>
    </ErrorState>
}
else if (_page is { Items.Count: 0 })
{
    <EmptyState Title="No patients have been registered yet" Message="Register a patient to begin building the registry." HasSearch="@HasSearch" />
}
else if (_page is not null)
{
    <section class="hms-panel" aria-labelledby="patient-results-heading">
        <div class="hms-panel__header">
            <div><p class="hms-eyebrow">Results</p><h2 id="patient-results-heading">Patient records</h2></div>
            <span class="hms-helper-text">Page @_page.PageNumber of @TotalPages</span>
        </div>
        <div class="hms-table-wrap">
            <table class="table hms-table">
                <caption class="visually-hidden">Patient registry results</caption>
                <thead><tr><th scope="col">Patient code</th><th scope="col">Name</th><th scope="col">Date of birth</th><th scope="col">Gender</th><th scope="col">Phone</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
                <tbody>
                @foreach (var patient in _page.Items)
                {
                    <tr>
                        <td><a href="@($"/patients/{patient.Id}")" class="hms-table__primary">@patient.PatientCode</a></td>
                        <td>@patient.FullName</td>
                        <td>@patient.DateOfBirth.ToString("dd MMM yyyy")</td>
                        <td>@patient.Gender</td>
                        <td>@patient.Phone</td>
                        <td class="hms-table__actions"><a class="btn btn-sm btn-outline-secondary" href="@($"/patients/{patient.Id}")">View</a><a class="btn btn-sm btn-outline-primary" href="@($"/patients/{patient.Id}/edit")">Edit</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <Pagination CurrentPage="@_page.PageNumber" TotalPages="@TotalPages" PageChanged="GoToPageAsync" />
    </section>
}

@code {
    private PagedResult<PatientSummaryDto>? _page;
    private string? _searchText;
    private string? _patientCode;
    private string? _phone;
    private string? _nationalId;
    private string? _passportNumber;
    private DateOnly? _dateOfBirth;
    private PatientSortField _sortBy = PatientSortField.PatientCode;
    private SortDirection _sortDirection = SortDirection.Ascending;
    private bool _loading;
    private bool _error;
    private int _pageNumber = 1;

    private int TotalPages => _page is null || _page.PageSize == 0 ? 1 : Math.Max(1, (int)Math.Ceiling((double)_page.TotalCount / _page.PageSize));
    private bool HasSearch => !string.IsNullOrWhiteSpace(_searchText) || !string.IsNullOrWhiteSpace(_patientCode) || !string.IsNullOrWhiteSpace(_phone) || !string.IsNullOrWhiteSpace(_nationalId) || !string.IsNullOrWhiteSpace(_passportNumber) || _dateOfBirth.HasValue;

    protected override Task OnInitializedAsync() => SearchAsync();

    private async Task SearchAsync()
    {
        _loading = true;
        _error = false;
        try
        {
            var result = await PatientService.SearchAsync(new PatientSearchRequest(
                _searchText, _patientCode, _phone, _nationalId, _passportNumber, _dateOfBirth, new PageRequest(_pageNumber, 25), _sortBy, _sortDirection));
            if (result.IsSuccess)
            {
                _page = result.Value;
            }
            else
            {
                _page = null;
                _error = true;
            }
        }
        catch (OperationCanceledException) { throw; }
        catch { _page = null; _error = true; }
        finally { _loading = false; }
    }

    private async Task ClearAsync()
    {
        _searchText = null;
        _patientCode = null;
        _phone = null;
        _nationalId = null;
        _passportNumber = null;
        _dateOfBirth = null;
        _pageNumber = 1;
        await SearchAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        _pageNumber = Math.Clamp(page, 1, TotalPages);
        await SearchAsync();
    }

    private static string SortLabel(PatientSortField field) => field switch
    {
        PatientSortField.PatientCode => "Patient code",
        PatientSortField.Name => "Name",
        PatientSortField.DateOfBirth => "Date of birth",
        PatientSortField.Phone => "Phone",
        _ => field.ToString()
    };
}
