@page "/queue/{QueueEntryId:int}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = PolicyNames.CanManageAppointments)]

@inject IQueueService QueueService

<PageTitle>Queue entry details</PageTitle>
@if (_loading){<LoadingState Message="Loading queue entry" />}
else if (_entry is null){<ErrorState Title="Queue entry unavailable" Message="@(_errorMessage ?? "The queue entry could not be loaded. Try again.")"><Actions><a class="btn btn-outline-secondary" href="/queue">Return to queue</a></Actions></ErrorState>}
else
{
    <PageHeader Eyebrow="Queue entry" Title="@_entry.QueueNumber" Description="Operational queue identity, linked appointment context, and valid lifecycle actions."><Actions><a class="btn btn-outline-secondary" href="/queue">Back to queue</a>@if(_entry.AppointmentId is int appointmentId){<a class="btn btn-outline-primary" href="@($"/appointments/{appointmentId}")">View appointment</a>}</Actions></PageHeader>
    @if(_created){<AppAlert Tone="AppAlert.AlertTone.Success" Title="Queue entry created" Message="The backend assigned this queue ticket and current Africa/Kigali queue date." />}
    @if(_successMessage is not null){<AppAlert Tone="AppAlert.AlertTone.Success" Title="Queue updated" Message="@_successMessage" />}
    @if(_errorMessage is not null){<AppAlert Tone="AppAlert.AlertTone.Danger" Title="Action not completed" Message="@_errorMessage" />}
    <div class="hms-detail-grid"><section class="hms-panel" aria-labelledby="queue-identity-heading"><div class="hms-panel__header"><div><p class="hms-eyebrow">Queue identity</p><h2 id="queue-identity-heading" class="hms-queue-number">@_entry.QueueNumber</h2></div><StatusBadge Text="@StatusLabel(_entry.Status)" Tone="@StatusTone(_entry.Status)" /></div><dl class="hms-detail-list"><dt>Entry type</dt><dd>@(_entry.AppointmentId.HasValue ? "Appointment-linked" : "Walk-in")</dd><dt>Patient</dt><dd>Patient record #@_entry.PatientId</dd><dt>Department</dt><dd>Department record #@_entry.DepartmentId</dd><dt>Queue date</dt><dd>@_entry.QueueDate.ToString("dd MMM yyyy") (Africa/Kigali)</dd><dt>Priority</dt><dd>@_entry.Priority</dd><dt>Status</dt><dd>@StatusLabel(_entry.Status)</dd><dt>Registered</dt><dd>@_entry.RegisteredAt.ToString("dd MMM yyyy HH:mm 'UTC'")</dd>@if(_entry.DoctorId is int doctorId){<dt>Doctor</dt><dd>Doctor record #@doctorId</dd>}</dl></section><section class="hms-panel" aria-labelledby="queue-context-heading"><div class="hms-panel__header"><div><p class="hms-eyebrow">Queue context</p><h2 id="queue-context-heading">Operational notes</h2></div></div><dl class="hms-detail-list"><dt>Notes</dt><dd>@(_entry.Notes??"Not recorded")</dd><dt>Called at</dt><dd>@(_entry.CalledAt?.ToString("dd MMM yyyy HH:mm 'UTC'")??"Not recorded")</dd><dt>Completed at</dt><dd>@(_entry.CompletedAt?.ToString("dd MMM yyyy HH:mm 'UTC'")??"Not recorded")</dd></dl></section></div>
    @if(_entry.Status is QueueStatus.Completed or QueueStatus.Cancelled){<AppAlert Tone="AppAlert.AlertTone.Information" Title="Historical queue state" Message="This entry remains available for history. Its Appointment link, if any, is preserved." />}
    else
    {
        <section class="hms-panel" aria-labelledby="queue-actions-heading"><div class="hms-panel__header"><div><p class="hms-eyebrow">Queue lifecycle</p><h2 id="queue-actions-heading">Available actions</h2></div><span class="hms-helper-text">Queue actions do not create an Encounter or automatically complete an Appointment.</span></div>
            @if(_entry.Status == QueueStatus.Waiting){<div class="hms-form__actions"><button type="button" class="btn btn-primary" @onclick="CallToNurseAsync" disabled="@_actionBusy">Call to nurse</button><button type="button" class="btn btn-outline-secondary" @onclick="OpenHold" disabled="@_actionBusy">Place on hold</button><button type="button" class="btn btn-outline-danger" @onclick="OpenCancel" disabled="@_actionBusy">Cancel queue entry</button></div>}
            else if(_entry.Status == QueueStatus.AtNurse){<div class="hms-form__grid"><div class="hms-field"><label for="send-doctor-id">Doctor record ID</label><InputNumber id="send-doctor-id" class="form-control" @bind-Value="_doctorId" /></div></div><div class="hms-form__actions"><button type="button" class="btn btn-primary" @onclick="SendToDoctorAsync" disabled="@_actionBusy">Send to doctor</button><button type="button" class="btn btn-outline-secondary" @onclick="OpenHold" disabled="@_actionBusy">Place on hold</button><button type="button" class="btn btn-outline-danger" @onclick="OpenCancel" disabled="@_actionBusy">Cancel queue entry</button></div>}
            else if(_entry.Status == QueueStatus.AtDoctor){<div class="hms-form__actions"><button type="button" class="btn btn-primary" @onclick="CompleteAsync" disabled="@_actionBusy">Complete queue entry</button><button type="button" class="btn btn-outline-danger" @onclick="OpenCancel" disabled="@_actionBusy">Cancel queue entry</button></div>}
            else if(_entry.Status == QueueStatus.OnHold){<div class="hms-form__actions"><button type="button" class="btn btn-primary" @onclick="ResumeAsync" disabled="@_actionBusy">Resume queue entry</button><button type="button" class="btn btn-outline-danger" @onclick="OpenCancel" disabled="@_actionBusy">Cancel queue entry</button></div>}
        </section>
    }
}
<ConfirmDialog IsOpen="@(_pendingAction != PendingAction.None)" Title="@ConfirmationTitle" Message="@ConfirmationMessage" ConfirmText="@ConfirmationButton" OnConfirm="ExecutePendingActionAsync" OnCancel="CloseConfirmation" />

@code {
    [Parameter] public int QueueEntryId { get; set; }
    [SupplyParameterFromQuery(Name="created")] private bool _created {get;set;}
    private QueueEntryDetailsDto? _entry; private bool _loading; private bool _actionBusy; private string? _errorMessage; private string? _successMessage; private int _doctorId; private PendingAction _pendingAction;
    private string ConfirmationTitle => _pendingAction switch{PendingAction.Hold=>"Place queue entry on hold?",PendingAction.Cancel=>"Cancel queue entry?",_=>"Confirm queue action"};
    private string ConfirmationMessage => _pendingAction switch{PendingAction.Hold=>"The entry will leave the active waiting flow until it is resumed.",PendingAction.Cancel=>"The queue entry will remain in history and its Appointment link, if any, will be preserved.",_=>"Confirm this operational queue action."};
    private string ConfirmationButton => _pendingAction switch{PendingAction.Hold=>"Place on hold",PendingAction.Cancel=>"Cancel entry",_=>"Confirm"};
    protected override async Task OnParametersSetAsync(){_loading=true;_errorMessage=null;try{var result=await QueueService.GetByIdAsync(QueueEntryId);if(result.IsSuccess)_entry=result.Value;else _errorMessage=result.Errors.FirstOrDefault()?.Message??"The queue entry was not found.";}catch(OperationCanceledException){throw;}catch{_errorMessage="The queue entry could not be loaded. Try again.";}finally{_loading=false;}}
    private void OpenHold(){_errorMessage=null;_pendingAction=PendingAction.Hold;} private void OpenCancel(){_errorMessage=null;_pendingAction=PendingAction.Cancel;} private void CloseConfirmation()=>_pendingAction=PendingAction.None;
    private async Task ExecutePendingActionAsync(){var action=_pendingAction;CloseConfirmation();await MutateAsync(action);}
    private Task CallToNurseAsync()=>MutateAsync(PendingAction.CallToNurse); private Task ResumeAsync()=>MutateAsync(PendingAction.Resume); private Task CompleteAsync()=>MutateAsync(PendingAction.Complete);
    private async Task SendToDoctorAsync(){if(_doctorId<=0){_errorMessage="Doctor record ID must be a positive whole number.";return;}await MutateAsync(PendingAction.SendToDoctor);}
    private async Task MutateAsync(PendingAction action){if(_entry is null||string.IsNullOrWhiteSpace(_entry.ConcurrencyToken))return;_actionBusy=true;_errorMessage=null;_successMessage=null;try{ServiceResult<QueueEntryDetailsDto> result=action switch{PendingAction.CallToNurse=>await QueueService.CallToNurseAsync(new QueueEntryActionRequest(QueueEntryId,_entry.ConcurrencyToken)),PendingAction.SendToDoctor=>await QueueService.SendToDoctorAsync(new SendToDoctorRequest(QueueEntryId,_doctorId,_entry.ConcurrencyToken)),PendingAction.Hold=>await QueueService.HoldAsync(new QueueEntryActionRequest(QueueEntryId,_entry.ConcurrencyToken)),PendingAction.Resume=>await QueueService.ResumeAsync(new QueueEntryActionRequest(QueueEntryId,_entry.ConcurrencyToken)),PendingAction.Complete=>await QueueService.CompleteAsync(new QueueEntryActionRequest(QueueEntryId,_entry.ConcurrencyToken)),PendingAction.Cancel=>await QueueService.CancelAsync(new QueueEntryActionRequest(QueueEntryId,_entry.ConcurrencyToken)),_=>ServiceResult<QueueEntryDetailsDto>.Failure(new ServiceError("queue.action.invalid","The queue action is not available."))};if(result.IsSuccess&&result.Value is not null){_entry=result.Value;_successMessage=action switch{PendingAction.CallToNurse=>"The queue entry was called to the nurse.",PendingAction.SendToDoctor=>"The queue entry was sent to the doctor stage.",PendingAction.Hold=>"The queue entry was placed on hold.",PendingAction.Resume=>"The queue entry was resumed.",PendingAction.Complete=>"The queue entry was completed.",PendingAction.Cancel=>"The queue entry was cancelled.",_=>"The queue entry was updated."};}else _errorMessage=ErrorMessage(result.Errors);}catch(OperationCanceledException){throw;}catch{_errorMessage="The queue operation could not be completed. Try again.";}finally{_actionBusy=false;}}
    private static string ErrorMessage(IReadOnlyList<ServiceError> errors)=>errors.FirstOrDefault()?.Code=="queue.concurrency_conflict"?"This queue entry changed in another operation. Reload the page before trying again.":errors.FirstOrDefault()?.Message??"The queue operation could not be completed.";
    private static string StatusLabel(QueueStatus status)=>status switch{QueueStatus.AtNurse=>"At nurse",QueueStatus.AtDoctor=>"At doctor",QueueStatus.OnHold=>"On hold",_=>status.ToString()}; private static StatusBadge.StatusTone StatusTone(QueueStatus status)=>status switch{QueueStatus.Completed=>StatusBadge.StatusTone.Success,QueueStatus.Cancelled=>StatusBadge.StatusTone.Neutral,QueueStatus.AtDoctor=>StatusBadge.StatusTone.Information,QueueStatus.AtNurse=>StatusBadge.StatusTone.Warning,QueueStatus.OnHold=>StatusBadge.StatusTone.Neutral,_=>StatusBadge.StatusTone.Information};
    private enum PendingAction{None,CallToNurse,SendToDoctor,Hold,Resume,Complete,Cancel}
}
