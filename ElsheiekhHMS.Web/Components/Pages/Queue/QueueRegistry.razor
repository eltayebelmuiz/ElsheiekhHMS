@page "/queue"
@rendermode InteractiveServer
@attribute [Authorize(Policy = PolicyNames.CanManageAppointments)]

@using System.Globalization
@inject IQueueService QueueService
@inject TimeProvider Clock

<PageTitle>Queue</PageTitle>
<PageHeader Eyebrow="Queue operations" Title="Operational queue" Description="Review the Africa/Kigali queue for a date and move entries through the approved operational stages.">
    <Actions><a class="btn btn-primary" href="/queue/new">Add walk-in</a></Actions>
</PageHeader>

<section class="hms-panel" aria-labelledby="queue-search-heading">
    <div class="hms-panel__header"><div><p class="hms-eyebrow">Queue registry</p><h2 id="queue-search-heading">Find queue entries</h2></div>@if (_page is not null){<span class="hms-result-count">@_page.TotalCount queue entr@( _page.TotalCount == 1 ? "y" : "ies")</span>}</div>
    <form class="hms-form" @onsubmit="SearchAsync" @onsubmit:preventDefault>
        <div class="hms-form__grid hms-form__grid--search">
            <div class="hms-field"><label for="queue-date">Queue date (Africa/Kigali)</label><input id="queue-date" class="form-control" type="date" value="@_queueDateText" @onchange="OnDateChanged" required /></div>
            <div class="hms-field"><label for="queue-status">Status</label><select id="queue-status" class="form-select" @bind="_status"><option value="">All statuses</option>@foreach (var status in Enum.GetValues<QueueStatus>()){<option value="@status">@StatusLabel(status)</option>}</select></div>
            <div class="hms-field"><label for="queue-priority">Priority</label><select id="queue-priority" class="form-select" @bind="_priority"><option value="">All priorities</option>@foreach (var priority in Enum.GetValues<QueuePriority>()){<option value="@priority">@priority</option>}</select></div>
            <div class="hms-field"><label for="queue-department">Department record ID</label><input id="queue-department" class="form-control" inputmode="numeric" @bind="_departmentId" /></div>
            <div class="hms-field"><label for="queue-doctor">Doctor record ID</label><input id="queue-doctor" class="form-control" inputmode="numeric" @bind="_doctorId" /></div>
        </div>
        <div class="hms-form__grid hms-form__grid--search-options"><div class="hms-field"><label for="queue-sort">Sort by</label><select id="queue-sort" class="form-select" @bind="_sortBy"><option value="@QueueSortField.Priority">Priority</option><option value="@QueueSortField.RegisteredAt">Registered time</option><option value="@QueueSortField.QueueNumber">Queue number</option></select></div><div class="hms-field"><label for="queue-direction">Direction</label><select id="queue-direction" class="form-select" @bind="_sortDirection"><option value="@SortDirection.Ascending">Ascending</option><option value="@SortDirection.Descending">Descending</option></select></div><div class="hms-form__actions hms-form__actions--inline"><button type="submit" class="btn btn-primary" disabled="@_loading">Search</button><button type="button" class="btn btn-outline-secondary" @onclick="ClearAsync" disabled="@_loading">Today</button></div></div>
    </form>
    @if (_validationMessage is not null){<AppAlert Tone="AppAlert.AlertTone.Warning" Title="Review the search" Message="@_validationMessage" />}
</section>

@if (_loading)
{
    <LoadingState Message="Loading queue entries" />
}
else if (_error)
{
    <ErrorState Title="Queue unavailable" Message="The operational queue could not be loaded. Try again."><Actions><button type="button" class="btn btn-outline-secondary" @onclick="SearchAsync">Retry</button></Actions></ErrorState>
}
else if (_page is { Items.Count: 0 })
{
    <EmptyState Title="No queue entries for this search" Message="Add a walk-in or adjust the queue date and filters." HasSearch="true" />
}
else if (_page is not null)
{
    <section class="hms-panel" aria-labelledby="queue-results-heading"><div class="hms-panel__header"><div><p class="hms-eyebrow">Results</p><h2 id="queue-results-heading">Queue entries</h2></div><span class="hms-helper-text">Page @_page.PageNumber of @TotalPages</span></div>
        <div class="hms-table-wrap"><table class="table hms-table hms-queue-table"><caption class="visually-hidden">Operational queue results</caption><thead><tr><th scope="col">Queue number</th><th scope="col">Patient</th><th scope="col">Department</th><th scope="col">Entry type</th><th scope="col">Priority</th><th scope="col">Status</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead><tbody>@foreach (var entry in _page.Items){<tr><td><a class="hms-queue-number" href="@($"/queue/{entry.Id}")">@entry.QueueNumber</a></td><td>Patient record #@entry.PatientId</td><td>Department #@entry.DepartmentId</td><td>@(entry.AppointmentId.HasValue ? "Appointment-linked" : "Walk-in")</td><td>@entry.Priority</td><td><StatusBadge Text="@StatusLabel(entry.Status)" Tone="@StatusTone(entry.Status)" /></td><td class="hms-table__actions"><a class="btn btn-sm btn-outline-secondary" href="@($"/queue/{entry.Id}")">View</a></td></tr>}</tbody></table></div>
        <Pagination CurrentPage="@_page.PageNumber" TotalPages="@TotalPages" PageChanged="GoToPageAsync" />
    </section>
}

@code {
    private PagedResult<QueueEntrySummaryDto>? _page;
    private string _queueDateText = string.Empty;
    private string? _status;
    private string? _priority;
    private string? _departmentId;
    private string? _doctorId;
    private QueueSortField _sortBy = QueueSortField.Priority;
    private SortDirection _sortDirection = SortDirection.Ascending;
    private int _pageNumber = 1;
    private bool _loading;
    private bool _error;
    private string? _validationMessage;
    private int TotalPages => _page is null || _page.PageSize == 0 ? 1 : Math.Max(1, (int)Math.Ceiling((double)_page.TotalCount / _page.PageSize));

    protected override void OnInitialized() => SetToday();
    protected override Task OnInitializedAsync() => SearchAsync();

    private async Task SearchAsync()
    {
        _validationMessage = null;
        if (!DateOnly.TryParseExact(_queueDateText, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var queueDate)){_page = null; _validationMessage = "Enter a valid queue date."; return;}
        if (!TryParsePositive(_departmentId, out var departmentId) || !TryParsePositive(_doctorId, out var doctorId)){_page = null; _validationMessage = "Record ID filters must be positive whole numbers when supplied."; return;}
        QueueStatus? status = null; QueuePriority? priority = null;
        if (!string.IsNullOrWhiteSpace(_status)){if (!Enum.TryParse<QueueStatus>(_status, out var parsed)){_page = null; _validationMessage = "Choose a valid queue status."; return;} status = parsed;}
        if (!string.IsNullOrWhiteSpace(_priority)){if (!Enum.TryParse<QueuePriority>(_priority, out var parsed)){_page = null; _validationMessage = "Choose a valid queue priority."; return;} priority = parsed;}
        _loading = true; _error = false;
        try
        {
            var result = await QueueService.SearchAsync(new QueueSearchRequest(queueDate, departmentId, doctorId, status, priority, new PageRequest(_pageNumber, 25), _sortBy, _sortDirection));
            if (result.IsSuccess) _page = result.Value; else {_page = null; _error = true;}
        }
        catch (OperationCanceledException){throw;}
        catch{_page = null; _error = true;}
        finally{_loading = false;}
    }

    private async Task ClearAsync(){SetToday(); _status = null; _priority = null; _departmentId = null; _doctorId = null; _pageNumber = 1; await SearchAsync();}
    private async Task GoToPageAsync(int page){_pageNumber = Math.Clamp(page, 1, TotalPages); await SearchAsync();}
    private void OnDateChanged(ChangeEventArgs args) => _queueDateText = args.Value?.ToString() ?? string.Empty;
    private void SetToday(){_queueDateText = KigaliToday().ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);}
    private DateOnly KigaliToday(){try{return DateOnly.FromDateTime(TimeZoneInfo.ConvertTimeBySystemTimeZoneId(Clock.GetUtcNow(), "Africa/Kigali").DateTime);}catch(TimeZoneNotFoundException){return DateOnly.FromDateTime(Clock.GetUtcNow().UtcDateTime);}catch(InvalidTimeZoneException){return DateOnly.FromDateTime(Clock.GetUtcNow().UtcDateTime);}}
    private static bool TryParsePositive(string? value, out int? parsed){if(string.IsNullOrWhiteSpace(value)){parsed=null;return true;}if(int.TryParse(value, NumberStyles.None, CultureInfo.InvariantCulture, out var number)&&number>0){parsed=number;return true;}parsed=null;return false;}
    private static string StatusLabel(QueueStatus status) => status switch { QueueStatus.AtNurse => "At nurse", QueueStatus.AtDoctor => "At doctor", QueueStatus.OnHold => "On hold", _ => status.ToString() };
    private static StatusBadge.StatusTone StatusTone(QueueStatus status) => status switch { QueueStatus.Completed => StatusBadge.StatusTone.Success, QueueStatus.Cancelled => StatusBadge.StatusTone.Neutral, QueueStatus.AtDoctor => StatusBadge.StatusTone.Information, QueueStatus.AtNurse => StatusBadge.StatusTone.Warning, QueueStatus.OnHold => StatusBadge.StatusTone.Neutral, _ => StatusBadge.StatusTone.Information };
}
