@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<PageHeader Eyebrow="Request failure" Title="This request could not be completed" Description="The system recorded the failure safely. No internal exception details are shown here." />
<ErrorState Title="Unexpected application error" Message="Try the action again. If the problem continues, contact your hospital administrator with the request identifier below." />

@if (ShowRequestId)
{
    <div class="hms-request-id" role="status"><strong>Request ID:</strong> <code>@RequestId</code></div>
}

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() => RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}