@page "/appointments/new"
@rendermode InteractiveServer
@attribute [Authorize(Policy = PolicyNames.CanManageAppointments)]

@using System.Globalization
@inject IAppointmentService AppointmentService
@inject IPatientService PatientService
@inject NavigationManager Navigation

<PageTitle>Schedule appointment</PageTitle>
<PageHeader Eyebrow="Appointment operations" Title="Schedule appointment" Description="Create a future appointment in the Africa/Kigali operational timezone using the approved scheduling workflow."><Actions><a class="btn btn-outline-secondary" href="/appointments">Cancel</a></Actions></PageHeader>

<section class="hms-panel" aria-labelledby="patient-lookup-heading">
    <div class="hms-panel__header"><div><p class="hms-eyebrow">Patient selection</p><h2 id="patient-lookup-heading">Find the patient record</h2></div></div>
    <form class="hms-form" @onsubmit="SearchPatientsAsync" @onsubmit:preventDefault>
        <div class="hms-form__grid hms-form__grid--search-options"><div class="hms-field"><label for="patient-lookup">Name, code, or phone</label><input id="patient-lookup" class="form-control" type="search" @bind="_patientSearch" maxlength="100" /></div><div class="hms-form__actions hms-form__actions--inline"><button type="submit" class="btn btn-outline-primary" disabled="@_patientLoading">@(_patientLoading ? "Searching…" : "Find patient")</button></div></div>
    </form>
    @if (_patientLookupMessage is not null){<p class="hms-helper-text" role="status">@_patientLookupMessage</p>}
    @if (_patientResults is { Items.Count: > 0 })
    {
        <div class="hms-table-wrap"><table class="table hms-table hms-lookup-table"><caption class="visually-hidden">Patient choices</caption><thead><tr><th scope="col">Patient code</th><th scope="col">Name</th><th scope="col">Phone</th><th scope="col"><span class="visually-hidden">Action</span></th></tr></thead><tbody>@foreach (var patient in _patientResults.Items){<tr><td>@patient.PatientCode</td><td>@patient.FullName</td><td>@patient.Phone</td><td class="hms-table__actions"><button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => SelectPatient(patient)">Select</button></td></tr>}</tbody></table></div>
    }
    @if (_selectedPatient is not null){<AppAlert Tone="AppAlert.AlertTone.Success" Title="Patient selected" Message="@($"{_selectedPatient.PatientCode} · {_selectedPatient.FullName}")" />}
</section>

@if (_errorMessage is not null){<AppAlert Tone="AppAlert.AlertTone.Danger" Title="Appointment was not scheduled" Message="@_errorMessage" />}
<EditForm Model="_model" OnSubmit="ScheduleAsync" class="hms-panel hms-form-panel"><DataAnnotationsValidator /><ValidationSummary />
    <section aria-labelledby="schedule-heading"><h2 id="schedule-heading">Scheduling details</h2><div class="hms-form__grid">
        <Field Label="Department record ID" Id="create-department-id" Required="true"><InputNumber id="create-department-id" class="form-control" @bind-Value="_model.DepartmentId" /></Field>
        <Field Label="Doctor record ID" Id="create-doctor-id" Required="true"><InputNumber id="create-doctor-id" class="form-control" @bind-Value="_model.DoctorId" /></Field>
        <Field Label="Date (Africa/Kigali)" Id="create-scheduled-date" Required="true"><input id="create-scheduled-date" class="form-control" type="date" value="@_model.ScheduledDateText" @onchange="OnScheduledDateChanged" /></Field>
        <Field Label="Time (Africa/Kigali)" Id="create-scheduled-time" Required="true"><input id="create-scheduled-time" class="form-control" type="time" value="@_model.ScheduledTimeText" @onchange="OnScheduledTimeChanged" /></Field>
        <Field Label="Appointment type" Id="create-appointment-type" Required="true"><InputSelect id="create-appointment-type" class="form-select" @bind-Value="_model.Type"><option value="">Select type</option>@foreach (var type in Enum.GetValues<AppointmentType>()){<option value="@type">@type</option>}</InputSelect></Field>
    </div></section>
    <section aria-labelledby="notes-heading"><h2 id="notes-heading">Notes</h2><div class="hms-field"><label for="create-appointment-notes">Operational notes <span class="hms-helper-text">Optional</span></label><InputTextArea id="create-appointment-notes" class="form-control" rows="4" maxlength="2000" @bind-Value="_model.Notes" /></div></section>
    <p class="hms-helper-text">The AppointmentCode is generated by the backend. Active Patient, Department, and Doctor records are checked by the scheduling service.</p>
    <div class="hms-form__actions"><button type="submit" class="btn btn-primary" disabled="@_saving">@(_saving ? "Scheduling…" : "Schedule appointment")</button><a class="btn btn-outline-secondary" href="/appointments">Cancel</a></div>
</EditForm>

@code {
    private readonly CreateModel _model = new();
    private string? _patientSearch;
    private PagedResult<PatientSummaryDto>? _patientResults;
    private PatientSummaryDto? _selectedPatient;
    private bool _patientLoading;
    private string? _patientLookupMessage;
    private bool _saving;
    private string? _errorMessage;

    private async Task SearchPatientsAsync()
    {
        _patientLoading = true; _patientLookupMessage = null;
        try
        {
            var result = await PatientService.SearchAsync(new PatientSearchRequest(_patientSearch, page: new PageRequest(1, 10)));
            if (result.IsSuccess && result.Value is not null){_patientResults = result.Value; _patientLookupMessage = result.Value.Items.Count == 0 ? "No patient records matched that search." : null;}
            else {_patientResults = null; _patientLookupMessage = "The patient lookup could not be completed.";}
        }
        catch (OperationCanceledException) { throw; }
        catch {_patientResults = null; _patientLookupMessage = "The patient lookup could not be completed. Try again.";}
        finally {_patientLoading = false;}
    }

    private void SelectPatient(PatientSummaryDto patient){_selectedPatient = patient; _model.PatientId = patient.Id;}
    private void OnScheduledDateChanged(ChangeEventArgs args) => _model.ScheduledDateText = args.Value?.ToString() ?? string.Empty;
    private void OnScheduledTimeChanged(ChangeEventArgs args) => _model.ScheduledTimeText = args.Value?.ToString() ?? string.Empty;

    private async Task ScheduleAsync()
    {
        _errorMessage = null;
        if (_selectedPatient is null){_errorMessage = "Select a patient record before scheduling."; return;}
        if (!DateOnly.TryParseExact(_model.ScheduledDateText, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var date) || !TimeOnly.TryParseExact(_model.ScheduledTimeText, "HH\\:mm", CultureInfo.InvariantCulture, DateTimeStyles.None, out var time))
        {_errorMessage = "Enter a valid future date and time in the Africa/Kigali timezone."; return;}
        if (_model.DepartmentId <= 0 || _model.DoctorId <= 0){_errorMessage = "Department and Doctor record IDs must be positive whole numbers."; return;}

        _saving = true;
        try
        {
            var result = await AppointmentService.ScheduleAsync(new CreateAppointmentRequest(_model.PatientId, _model.DoctorId, _model.DepartmentId, date, time, _model.Type, _model.Notes));
            if (result.IsSuccess && result.Value is not null) Navigation.NavigateTo($"/appointments/{result.Value.Id}?created=true"); else _errorMessage = ErrorMessage(result.Errors);
        }
        catch (OperationCanceledException) { throw; }
        catch {_errorMessage = "The appointment operation could not be completed. Try again.";}
        finally {_saving = false;}
    }

    private static string ErrorMessage(IReadOnlyList<ServiceError> errors) => errors.FirstOrDefault()?.Code switch
    {
        "appointment.collision" => "Another active appointment is already scheduled for this department at this time.",
        "appointment.scheduled_time.past" or "appointment.scheduled_time.invalid" or "appointment.scheduled_time.ambiguous" => errors.FirstOrDefault()?.Message ?? "Choose a valid future time in Africa/Kigali.",
        _ => errors.FirstOrDefault()?.Message ?? "Review the scheduling details and try again."
    };

    private sealed class CreateModel
    {
        public int PatientId { get; set; }
        public int DoctorId { get; set; }
        public int DepartmentId { get; set; }
        public string ScheduledDateText { get; set; } = string.Empty;
        public string ScheduledTimeText { get; set; } = string.Empty;
        public AppointmentType Type { get; set; }
        public string? Notes { get; set; }
    }
}
