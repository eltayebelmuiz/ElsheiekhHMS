@page "/appointments"
@rendermode InteractiveServer
@attribute [Authorize(Policy = PolicyNames.CanManageAppointments)]

@using System.Globalization
@inject IAppointmentService AppointmentService
@inject TimeProvider Clock

<PageTitle>Appointments</PageTitle>
<PageHeader Eyebrow="Appointment operations" Title="Appointments" Description="Find scheduled visits, review their lifecycle state, and open the approved operational actions.">
    <Actions><a class="btn btn-primary" href="/appointments/new">Schedule appointment</a></Actions>
</PageHeader>

<section class="hms-panel" aria-labelledby="appointment-search-heading">
    <div class="hms-panel__header"><div><p class="hms-eyebrow">Appointment registry</p><h2 id="appointment-search-heading">Search appointments</h2></div>@if (_page is not null){<span class="hms-result-count">@_page.TotalCount appointment@( _page.TotalCount == 1 ? "" : "s")</span>}</div>
    <form class="hms-form" @onsubmit="SearchAsync" @onsubmit:preventDefault>
        <div class="hms-form__grid hms-form__grid--search">
            <div class="hms-field"><label for="appointment-from">From date</label><input id="appointment-from" class="form-control" type="date" value="@_fromDateText" @onchange="OnFromDateChanged" required /></div>
            <div class="hms-field"><label for="appointment-to">To date</label><input id="appointment-to" class="form-control" type="date" value="@_toDateText" @onchange="OnToDateChanged" required /></div>
            <div class="hms-field"><label for="appointment-status">Status</label><select id="appointment-status" class="form-select" @bind="_status"><option value="">All statuses</option>@foreach (var status in Enum.GetValues<AppointmentStatus>()){<option value="@status">@StatusLabel(status)</option>}</select></div>
            <div class="hms-field"><label for="appointment-patient">Patient record ID</label><input id="appointment-patient" class="form-control" inputmode="numeric" @bind="_patientId" /></div>
            <div class="hms-field"><label for="appointment-department">Department record ID</label><input id="appointment-department" class="form-control" inputmode="numeric" @bind="_departmentId" /></div>
            <div class="hms-field"><label for="appointment-doctor">Doctor record ID</label><input id="appointment-doctor" class="form-control" inputmode="numeric" @bind="_doctorId" /></div>
        </div>
        <div class="hms-form__grid hms-form__grid--search-options">
            <div class="hms-field"><label for="appointment-sort">Sort by</label><select id="appointment-sort" class="form-select" @bind="_sortBy"><option value="@AppointmentSortField.ScheduledDateTime">Scheduled time</option><option value="@AppointmentSortField.Status">Status</option></select></div>
            <div class="hms-field"><label for="appointment-direction">Direction</label><select id="appointment-direction" class="form-select" @bind="_sortDirection"><option value="@SortDirection.Ascending">Ascending</option><option value="@SortDirection.Descending">Descending</option></select></div>
            <div class="hms-form__actions hms-form__actions--inline"><button type="submit" class="btn btn-primary" disabled="@_loading">Search</button><button type="button" class="btn btn-outline-secondary" @onclick="ClearAsync" disabled="@_loading">Clear</button></div>
        </div>
    </form>
    @if (_validationMessage is not null){<AppAlert Tone="AppAlert.AlertTone.Warning" Title="Review the search" Message="@_validationMessage" />}
</section>

@if (_loading)
{
    <LoadingState Message="Loading appointments" />
}
else if (_error)
{
    <ErrorState Title="Appointments unavailable" Message="The appointment registry could not be loaded. Try again."><Actions><button type="button" class="btn btn-outline-secondary" @onclick="SearchAsync">Retry</button></Actions></ErrorState>
}
else if (_page is { Items.Count: 0 })
{
    <EmptyState Title="No appointments match this search" Message="Adjust the date range or filters and search again." HasSearch="true" />
}
else if (_page is not null)
{
    <section class="hms-panel" aria-labelledby="appointment-results-heading">
        <div class="hms-panel__header"><div><p class="hms-eyebrow">Results</p><h2 id="appointment-results-heading">Scheduled visits</h2></div><span class="hms-helper-text">Page @_page.PageNumber of @TotalPages</span></div>
        <div class="hms-table-wrap"><table class="table hms-table hms-appointment-table"><caption class="visually-hidden">Appointment registry results</caption><thead><tr><th scope="col">Appointment code</th><th scope="col">Patient</th><th scope="col">Department</th><th scope="col">Doctor</th><th scope="col">Scheduled time (Kigali)</th><th scope="col">Status</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead><tbody>
        @foreach (var appointment in _page.Items)
        {
            <tr><td><a class="hms-table__primary" href="@($"/appointments/{appointment.Id}")">@appointment.AppointmentCode</a></td><td>Patient record #@appointment.PatientId</td><td>Department #@appointment.DepartmentId</td><td>Doctor #@appointment.DoctorId</td><td>@FormatScheduled(appointment.ScheduledDate, appointment.ScheduledTime)</td><td><StatusBadge Text="@StatusLabel(appointment.Status)" Tone="@StatusTone(appointment.Status)" /></td><td class="hms-table__actions"><a class="btn btn-sm btn-outline-secondary" href="@($"/appointments/{appointment.Id}")">View</a></td></tr>
        }
        </tbody></table></div>
        <Pagination CurrentPage="@_page.PageNumber" TotalPages="@TotalPages" PageChanged="GoToPageAsync" />
    </section>
}

@code {
    private PagedResult<AppointmentSummaryDto>? _page;
    private string _fromDateText = string.Empty;
    private string _toDateText = string.Empty;
    private string? _status;
    private string? _patientId;
    private string? _departmentId;
    private string? _doctorId;
    private AppointmentSortField _sortBy = AppointmentSortField.ScheduledDateTime;
    private SortDirection _sortDirection = SortDirection.Ascending;
    private int _pageNumber = 1;
    private bool _loading;
    private bool _error;
    private string? _validationMessage;

    private int TotalPages => _page is null || _page.PageSize == 0 ? 1 : Math.Max(1, (int)Math.Ceiling((double)_page.TotalCount / _page.PageSize));

    protected override void OnInitialized()
    {
        var today = KigaliToday();
        _fromDateText = today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        _toDateText = today.AddDays(30).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
    }

    protected override Task OnInitializedAsync() => SearchAsync();

    private async Task SearchAsync()
    {
        _validationMessage = null;
        if (!DateOnly.TryParseExact(_fromDateText, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var from) ||
            !DateOnly.TryParseExact(_toDateText, "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var to))
        {
            _page = null; _validationMessage = "Enter both a valid from date and to date."; return;
        }

        if (!TryParsePositive(_patientId, out var patientId) || !TryParsePositive(_departmentId, out var departmentId) || !TryParsePositive(_doctorId, out var doctorId))
        {
            _page = null; _validationMessage = "Record ID filters must be positive whole numbers when supplied."; return;
        }

        AppointmentStatus? status = null;
        AppointmentStatus parsedStatus = default;
        if (!string.IsNullOrWhiteSpace(_status) && (!Enum.TryParse<AppointmentStatus>(_status, out parsedStatus)))
        {
            _page = null; _validationMessage = "Choose a valid appointment status."; return;
        }
        else if (!string.IsNullOrWhiteSpace(_status)) status = parsedStatus;

        _loading = true; _error = false;
        try
        {
            var result = await AppointmentService.SearchAsync(new AppointmentSearchRequest(from, to, patientId, doctorId, departmentId, status, new PageRequest(_pageNumber, 25), _sortBy, _sortDirection));
            if (result.IsSuccess) _page = result.Value; else { _page = null; _error = true; }
        }
        catch (OperationCanceledException) { throw; }
        catch { _page = null; _error = true; }
        finally { _loading = false; }
    }

    private async Task ClearAsync()
    {
        var today = KigaliToday();
        _fromDateText = today.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        _toDateText = today.AddDays(30).ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
        _status = null; _patientId = null; _departmentId = null; _doctorId = null; _pageNumber = 1;
        await SearchAsync();
    }

    private async Task GoToPageAsync(int page) { _pageNumber = Math.Clamp(page, 1, TotalPages); await SearchAsync(); }

    private void OnFromDateChanged(ChangeEventArgs args) => _fromDateText = args.Value?.ToString() ?? string.Empty;
    private void OnToDateChanged(ChangeEventArgs args) => _toDateText = args.Value?.ToString() ?? string.Empty;

    private DateOnly KigaliToday()
    {
        try { return DateOnly.FromDateTime(TimeZoneInfo.ConvertTimeBySystemTimeZoneId(Clock.GetUtcNow(), "Africa/Kigali").DateTime); }
        catch (TimeZoneNotFoundException) { return DateOnly.FromDateTime(Clock.GetUtcNow().UtcDateTime); }
        catch (InvalidTimeZoneException) { return DateOnly.FromDateTime(Clock.GetUtcNow().UtcDateTime); }
    }

    private static bool TryParsePositive(string? value, out int? parsed)
    {
        if (string.IsNullOrWhiteSpace(value)) { parsed = null; return true; }
        if (int.TryParse(value, NumberStyles.None, CultureInfo.InvariantCulture, out var number) && number > 0) { parsed = number; return true; }
        parsed = null; return false;
    }

    private static string FormatScheduled(DateOnly date, TimeOnly time) => $"{date:dd MMM yyyy} · {time:HH\\:mm}";
    private static string StatusLabel(AppointmentStatus status) => status switch { AppointmentStatus.NoShow => "No-show", AppointmentStatus.CheckedIn => "Checked in", _ => status.ToString() };
    private static StatusBadge.StatusTone StatusTone(AppointmentStatus status) => status switch { AppointmentStatus.Completed => StatusBadge.StatusTone.Success, AppointmentStatus.Cancelled or AppointmentStatus.NoShow => StatusBadge.StatusTone.Neutral, AppointmentStatus.CheckedIn => StatusBadge.StatusTone.Information, AppointmentStatus.Confirmed => StatusBadge.StatusTone.Warning, _ => StatusBadge.StatusTone.Information };
}
