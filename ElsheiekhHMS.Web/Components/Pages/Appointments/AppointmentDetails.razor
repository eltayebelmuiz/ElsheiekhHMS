@page "/appointments/{AppointmentId:int}"
@rendermode InteractiveServer
@attribute [Authorize(Policy = PolicyNames.CanManageAppointments)]

@inject IAppointmentService AppointmentService
@inject NavigationManager Navigation

<PageTitle>Appointment details</PageTitle>
@if (_loading)
{
    <LoadingState Message="Loading appointment details" />
}
else if (_errorMessage is not null && _appointment is null)
{
    <ErrorState Title="Appointment details unavailable" Message="@_errorMessage"><Actions><a class="btn btn-outline-secondary" href="/appointments">Return to appointments</a></Actions></ErrorState>
}
else if (_appointment is not null)
{
    <PageHeader Eyebrow="Appointment record" Title="@_appointment.AppointmentCode" Description="Scheduling and attendance lifecycle details for this appointment."><Actions><a class="btn btn-outline-secondary" href="/appointments">Back to appointments</a></Actions></PageHeader>
    @if (_created){<AppAlert Tone="AppAlert.AlertTone.Success" Title="Appointment scheduled" Message="The appointment was scheduled and its AppointmentCode was generated by the backend." />}
    @if (_successMessage is not null){<AppAlert Tone="AppAlert.AlertTone.Success" Title="Appointment updated" Message="@_successMessage" />}
    @if (_errorMessage is not null){<AppAlert Tone="AppAlert.AlertTone.Danger" Title="Action not completed" Message="@_errorMessage" />}
    <div class="hms-detail-grid">
        <section class="hms-panel" aria-labelledby="appointment-summary-heading"><div class="hms-panel__header"><div><p class="hms-eyebrow">Appointment record</p><h2 id="appointment-summary-heading">@_appointment.AppointmentCode</h2></div><StatusBadge Text="@StatusLabel(_appointment.Status)" Tone="@StatusTone(_appointment.Status)" /></div><dl class="hms-detail-list"><dt>Patient</dt><dd>Patient record #@_appointment.PatientId</dd><dt>Department</dt><dd>Department record #@_appointment.DepartmentId</dd><dt>Doctor</dt><dd>Doctor record #@_appointment.DoctorId</dd><dt>Scheduled time</dt><dd>@FormatScheduled(_appointment.ScheduledDate, _appointment.ScheduledTime) (Africa/Kigali)</dd><dt>Appointment type</dt><dd>@_appointment.Type</dd><dt>Status</dt><dd>@StatusLabel(_appointment.Status)</dd></dl></section>
        <section class="hms-panel" aria-labelledby="appointment-notes-heading"><div class="hms-panel__header"><div><p class="hms-eyebrow">Operational notes</p><h2 id="appointment-notes-heading">Record context</h2></div></div><dl class="hms-detail-list"><dt>Notes</dt><dd>@(_appointment.Notes ?? "Not recorded")</dd><dt>Cancellation reason</dt><dd>@(_appointment.CancellationReason ?? "Not applicable")</dd><dt>Cancelled at</dt><dd>@(_appointment.CancelledAt?.ToString("dd MMM yyyy HH:mm 'UTC'") ?? "Not applicable")</dd></dl></section>
    </div>
    @if (_appointment.Status == AppointmentStatus.Cancelled || _appointment.Status == AppointmentStatus.NoShow || _appointment.Status == AppointmentStatus.Completed)
    {
        <AppAlert Tone="AppAlert.AlertTone.Information" Title="Historical lifecycle state" Message="This appointment remains available for history. No further lifecycle action is available from this state." />
    }
    else
    {
        <section class="hms-panel" aria-labelledby="appointment-actions-heading"><div class="hms-panel__header"><div><p class="hms-eyebrow">Approved lifecycle</p><h2 id="appointment-actions-heading">Available actions</h2></div><span class="hms-helper-text">No rescheduling, deletion, Queue, or Encounter action is available here.</span></div>
            @if (_appointment.Status is AppointmentStatus.Scheduled or AppointmentStatus.Confirmed)
            {
                <div class="hms-form__actions"><button type="button" class="btn btn-primary" @onclick="CheckInAsync" disabled="@_actionBusy">Check in</button><button type="button" class="btn btn-outline-secondary" @onclick="OpenNoShow" disabled="@_actionBusy">Mark no-show</button><button type="button" class="btn btn-outline-danger" @onclick="OpenCancel" disabled="@_actionBusy">Cancel appointment</button></div>
            }
            else if (_appointment.Status == AppointmentStatus.CheckedIn)
            {
                <div class="hms-form__actions"><button type="button" class="btn btn-primary" @onclick="OpenComplete" disabled="@_actionBusy">Complete appointment</button></div>
            }
            @if (_pendingAction == PendingAction.Cancel){<div class="hms-field hms-inline-action"><label for="cancel-reason">Cancellation reason <span class="hms-helper-text">Optional</span></label><InputText id="cancel-reason" class="form-control" @bind-Value="_cancelReason" maxlength="500" /></div>}
        </section>
    }
}

<ConfirmDialog IsOpen="@(_pendingAction != PendingAction.None)" Title="@ConfirmationTitle" Message="@ConfirmationMessage" ConfirmText="@ConfirmationButton" OnConfirm="ExecutePendingActionAsync" OnCancel="CloseConfirmation" />

@code {
    [Parameter] public int AppointmentId { get; set; }
    [SupplyParameterFromQuery(Name = "created")] private bool _created { get; set; }
    private AppointmentDetailsDto? _appointment;
    private bool _loading;
    private bool _actionBusy;
    private string? _errorMessage;
    private string? _successMessage;
    private string? _cancelReason;
    private PendingAction _pendingAction;

    private string ConfirmationTitle => _pendingAction switch { PendingAction.Cancel => "Cancel appointment?", PendingAction.NoShow => "Mark appointment as no-show?", PendingAction.Complete => "Complete appointment?", _ => "Confirm action" };
    private string ConfirmationMessage => _pendingAction switch { PendingAction.Cancel => "The appointment will remain in history and will no longer occupy its scheduling slot.", PendingAction.NoShow => "The appointment will remain in history as a no-show and will no longer occupy its scheduling slot.", PendingAction.Complete => "The appointment will be marked as completed. This does not create or complete an Encounter or Queue record.", _ => "Confirm this lifecycle action." };
    private string ConfirmationButton => _pendingAction switch { PendingAction.Cancel => "Cancel appointment", PendingAction.NoShow => "Mark no-show", PendingAction.Complete => "Complete appointment", _ => "Confirm" };

    protected override async Task OnParametersSetAsync()
    {
        _loading = true; _errorMessage = null;
        try
        {
            var result = await AppointmentService.GetByIdAsync(AppointmentId);
            if (result.IsSuccess) _appointment = result.Value; else _errorMessage = result.Errors.FirstOrDefault()?.Message ?? "The appointment was not found.";
        }
        catch (OperationCanceledException) { throw; }
        catch { _errorMessage = "The appointment details could not be loaded. Try again."; }
        finally { _loading = false; }
    }

    private void OpenCancel(){_errorMessage = null; _cancelReason = null; _pendingAction = PendingAction.Cancel;}
    private void OpenNoShow(){_errorMessage = null; _pendingAction = PendingAction.NoShow;}
    private void OpenComplete(){_errorMessage = null; _pendingAction = PendingAction.Complete;}
    private void CloseConfirmation(){_pendingAction = PendingAction.None; _cancelReason = null;}

    private async Task CheckInAsync() => await MutateAsync(PendingAction.CheckIn);

    private async Task ExecutePendingActionAsync()
    {
        var action = _pendingAction;
        CloseConfirmation();
        await MutateAsync(action);
    }

    private async Task MutateAsync(PendingAction action)
    {
        if (_appointment is null || string.IsNullOrWhiteSpace(_appointment.ConcurrencyToken)) return;
        _actionBusy = true; _errorMessage = null; _successMessage = null;
        try
        {
            ServiceResult<AppointmentDetailsDto> result = action switch
            {
                PendingAction.Cancel => await AppointmentService.CancelAsync(new CancelAppointmentRequest(AppointmentId, _cancelReason, _appointment.ConcurrencyToken)),
                PendingAction.NoShow => await AppointmentService.MarkNoShowAsync(new AppointmentActionRequest(AppointmentId, _appointment.ConcurrencyToken)),
                PendingAction.CheckIn => await AppointmentService.CheckInAsync(new AppointmentActionRequest(AppointmentId, _appointment.ConcurrencyToken)),
                PendingAction.Complete => await AppointmentService.CompleteAsync(new AppointmentActionRequest(AppointmentId, _appointment.ConcurrencyToken)),
                _ => ServiceResult<AppointmentDetailsDto>.Failure(new ServiceError("appointment.action.invalid", "The appointment action is not available."))
            };
            if (result.IsSuccess && result.Value is not null){_appointment = result.Value; _successMessage = action switch { PendingAction.Cancel => "The appointment was cancelled.", PendingAction.NoShow => "The appointment was marked as no-show.", PendingAction.CheckIn => "The appointment was checked in.", PendingAction.Complete => "The appointment was completed.", _ => "The appointment was updated." };}
            else _errorMessage = ErrorMessage(result.Errors);
        }
        catch (OperationCanceledException) { throw; }
        catch {_errorMessage = "The appointment operation could not be completed. Try again.";}
        finally {_actionBusy = false;}
    }

    private static string ErrorMessage(IReadOnlyList<ServiceError> errors) => errors.FirstOrDefault()?.Code == "appointment.concurrency_conflict" ? "This appointment changed in another operation. Reload the page before trying again." : errors.FirstOrDefault()?.Message ?? "The appointment operation could not be completed.";
    private static string FormatScheduled(DateOnly date, TimeOnly time) => $"{date:dd MMM yyyy} · {time:HH\\:mm}";
    private static string StatusLabel(AppointmentStatus status) => status switch { AppointmentStatus.NoShow => "No-show", AppointmentStatus.CheckedIn => "Checked in", _ => status.ToString() };
    private static StatusBadge.StatusTone StatusTone(AppointmentStatus status) => status switch { AppointmentStatus.Completed => StatusBadge.StatusTone.Success, AppointmentStatus.Cancelled or AppointmentStatus.NoShow => StatusBadge.StatusTone.Neutral, AppointmentStatus.CheckedIn => StatusBadge.StatusTone.Information, AppointmentStatus.Confirmed => StatusBadge.StatusTone.Warning, _ => StatusBadge.StatusTone.Information };
    private enum PendingAction { None, Cancel, NoShow, CheckIn, Complete }
}
