<section class="hms-state hms-state--error" role="alert" aria-labelledby="@HeadingId">
    <span class="hms-state__mark" aria-hidden="true">!</span>
    <div>
        <h2 id="@HeadingId">@Title</h2>
        <p>@Message</p>
        @if (Actions is not null)
        {
            <div class="hms-state__actions">@Actions</div>
        }
    </div>
</section>

@code {
    [Parameter] public string Title { get; set; } = "Something went wrong";
    [Parameter] public string Message { get; set; } = "The request could not be completed. Try again or contact support.";
    [Parameter] public string HeadingId { get; set; } = "error-state-heading";
    [Parameter] public RenderFragment? Actions { get; set; }
}
