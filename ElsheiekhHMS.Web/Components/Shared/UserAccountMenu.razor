<AuthorizeView>
    <Authorized Context="authState">
        <details class="hms-account-menu">
            <summary class="hms-account-menu__summary">
                <span class="hms-account-menu__avatar" aria-hidden="true">@Initial(authState.User.Identity?.Name)</span>
                <span class="hms-account-menu__identity">
                    <strong>@(authState.User.Identity?.Name ?? "Authenticated user")</strong>
                    <small>@RoleSummary(authState.User)</small>
                </span>
            </summary>
            <div class="hms-account-menu__panel">
                <p class="hms-account-menu__hint">Signed in with an approved hospital account.</p>
                <form method="post" action="/account/logout">
                    <AntiforgeryToken />
                    <button type="submit" class="btn btn-outline-secondary hms-account-menu__logout">Sign out</button>
                </form>
            </div>
        </details>
    </Authorized>
    <NotAuthorized>
        <a class="hms-user-area__signin" href="/login">Sign in</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    private static string Initial(string? userName) =>
        string.IsNullOrWhiteSpace(userName) ? "U" : userName.Trim()[0].ToString().ToUpperInvariant();

    private static string RoleSummary(ClaimsPrincipal principal)
    {
        var roles = RoleNames.All.Where(principal.IsInRole).ToArray();
        return roles.Length == 0 ? "Authorized account" : string.Join(" · ", roles);
    }
}
