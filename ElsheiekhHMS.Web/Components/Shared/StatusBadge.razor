<span class="hms-status hms-status--@Tone.ToString().ToLowerInvariant()">
    <span class="hms-status__marker" aria-hidden="true"></span>
    <span>@Text</span>
</span>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;
    [Parameter] public StatusTone Tone { get; set; } = StatusTone.Neutral;

    public enum StatusTone
    {
        Neutral,
        Success,
        Warning,
        Danger,
        Information
    }
}
