@if (TotalPages > 1)
{
    <nav class="hms-pagination" aria-label="Pagination">
        <button type="button" class="btn btn-outline-secondary" disabled="@(CurrentPage <= 1)" @onclick="() => PageChanged.InvokeAsync(CurrentPage - 1)">Previous</button>
        <span aria-live="polite">Page @CurrentPage of @TotalPages</span>
        <button type="button" class="btn btn-outline-secondary" disabled="@(CurrentPage >= TotalPages)" @onclick="() => PageChanged.InvokeAsync(CurrentPage + 1)">Next</button>
    </nav>
}

@code {
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public EventCallback<int> PageChanged { get; set; }
}
