<section class="hms-state hms-state--empty" aria-labelledby="@HeadingId">
    <span class="hms-state__mark" aria-hidden="true">—</span>
    <div>
        <h2 id="@HeadingId">@(HasSearch ? "No results match your search" : Title)</h2>
        <p>@(HasSearch ? "Try clearing a filter or using a broader search." : Message)</p>
        @if (Actions is not null)
        {
            <div class="hms-state__actions">@Actions</div>
        }
    </div>
</section>

@code {
    [Parameter] public string Title { get; set; } = "Nothing here yet";
    [Parameter] public string Message { get; set; } = "No records are available.";
    [Parameter] public bool HasSearch { get; set; }
    [Parameter] public string HeadingId { get; set; } = "empty-state-heading";
    [Parameter] public RenderFragment? Actions { get; set; }
}
